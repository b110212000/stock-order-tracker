{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orderlead-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "services": [
    {
      "binding": "MLB_MAIL",
      "service": "mlb-score-notify",
      "entrypoint": "OrderLeadMailService"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orderlead-db",
      "database_id": "2a936aeb-c4f8-4827-a264-d4f56d5e8471",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_REQUEST_LIMITER",
      "namespace_id": "87500087",
      "simple": {
        "limit": 24,
        "period": 60
      }
    }
  ],
  "vars": {
    "AUTH_ROUTES_ENABLED": "true",
    "AUTH_BASIC_LIMITS_READY": "true",
    "EMAIL_AUTH_ENABLED": "true",
    "BACKUP_RECOVERY_ENABLED": "true"
  },
  "secrets": {
    "required": [
      "PASSWORD_PEPPER"
    ]
  }
}
